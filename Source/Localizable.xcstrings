    "All five cards share a suit without forming a run.": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "All five cards share a suit without forming a run."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتمي الأوراق الخمس إلى النوع نفسه دون أن تتتابع قيمها."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "五張牌花色相同，但點數沒有連號。"
          }
        }
      }
    },
    "All five ranks differ. They do not form a run or share a suit.": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "All five ranks differ. They do not form a run or share a suit."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تختلف القيم الخمس. لا تشكّل الأوراق تسلسلًا ولا تنتمي كلّها إلى نوع واحد."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "五張牌的點數都不同，既沒有連號，也不是同一花色。"
          }
        }
      }
    },
    "All five ranks run in sequence and all five cards share a suit.": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "All five ranks run in sequence and all five cards share a suit."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتتابع القيم الخمس وتنتمي الأوراق كلّها إلى النوع نفسه."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "五張牌點數相連，花色也完全相同。"
          }
        }
      }
    },
