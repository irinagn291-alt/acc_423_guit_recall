    "Every suit has a distinct shape. VoiceOver reads the rank and suit of each card.": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Every suit has a distinct shape. VoiceOver reads the rank and suit of each card."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لكل نوع من الورق رمز مختلف. يقرأ VoiceOver قيمة كل ورقة ونوعها."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每種花色都有不同的形狀。VoiceOver 會讀出每張牌的點數與花色。"
